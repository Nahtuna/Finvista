# --- DATABASE CONFIGURATION ---
DATABASE_URL=postgresql://user:password@host:port/database

# --- DATABASE CONNECTION POOLING (PostgreSQL only) ---
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=3600

# --- SECURITY & AUTHENTICATION ---
JWT_SECRET_KEY=your_super_secure_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- TELEGRAM BOT WEBHOOK ALERTS ---
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE
TELEGRAM_ALERTS_ENABLED=false

# --- ML HYPERPARAMETER TUNING ---
FINVISTA_TUNE=1
FINVISTA_TUNE_BOOST=1
FINVISTA_TUNE_NITER=30
FINVISTA_TUNE_NITER_BOOST=30

# --- SMOTE DATA BALANCING ---
FINVISTA_USE_SMOTE=1

# --- AI Configuration (OpenRouter & Gemini) ---
OPENROUTER_API_KEY=
OPENROUTER_BATCH_MODEL=openrouter/free
OPENROUTER_DEEP_MODEL=openrouter/free

# --- AI Proxy Ports (gemini_web2api) ---
# Mỗi module dùng port riêng để tránh rate limit
AI_PROXY_CHAT_PORT=8081          # Chat Assistant
AI_PROXY_NEWS_IMPACT_PORT=8082  # News Impact Analysis
AI_PROXY_ANNUAL_REPORTS_PORT=8083  # Annual Reports Analysis
AI_PROXY_AI_COMMITTEE_PORT=8084    # AI Committee Trading
AI_PROXY_CREDIT_RISK_PORT=8085      # Credit Risk Analysis
AI_PROXY_MARKET_OVERVIEW_PORT=8086 # Market Overview

# --- AI Response Caching ---
# Giảm AI calls bằng cách cache responses
AI_CACHE_TTL=3600          # Cache TTL in seconds (default: 1 hour)
AI_CACHE_MAX_SIZE=1000      # Maximum number of cached responses per module

# --- CACHING LAYER (REDIS) ---
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=10

# --- REGIME SYSTEM CONFIGURATION ---
REGIME_PERFORMANCE_MODE=HYBRID  # Options: FAST, HYBRID, FULL
REGIME_CACHE_ENABLED=true
REGIME_ASYNC_ENABLED=true
REGIME_TTL_SECONDS=600  # Cache TTL in seconds (default: 10 minutes)

# --- VNSTOCK ---
VNSTOCK_API_KEY=

# --- FIREANT (bai viet phan tich cho RAG) ---
FIREANT_TOKEN=
