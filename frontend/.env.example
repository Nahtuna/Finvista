VITE_API_BASE_URL=http://127.0.0.1:8008
VITE_AUTH_ENABLED=true

# Cache TTL Configuration (in milliseconds)
VITE_DEFAULT_TTL_MS=30000
VITE_REGIME_TTL_MS=120000
VITE_WARRANTS_TTL_MS=60000
VITE_MARKET_TTL_MS=45000
VITE_MACRO_TTL_MS=60000
VITE_PORTFOLIO_TTL_MS=5000
VITE_CREDIT_TTL_MS=120000
VITE_NEWS_TTL_MS=180000

# Firebase web config is public-safe, but only use values from your own Firebase project.
# When these values are present, the frontend shows Google login.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
